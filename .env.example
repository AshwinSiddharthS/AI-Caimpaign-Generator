NODE_ENV=development
PORT=5000

# AI Provider: "gemini" (production) or "mock" (dev/testing without quota)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Ordered comma-separated list of Gemini models to try (fastest/cheapest first)
# The server falls back to the next model on 429/503. Remove any you don't want.
GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash

AI_TEMPERATURE=0.9
AI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# CORS — comma-separated allowed origins (Vite dev server + your production URL)
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
